# ==============================================================================
# KONNECTOR AI - MASTER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure the secrets for your environment.
# In GCP Cloud Run, these secrets are injected via Google Secret Manager.

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
FRONTEND_PORT=3000
APP_NAME="Konnector AI"
FRONTEND_URL="https://app.konnector.ai"
BACKEND_API_URL="https://api.konnector.ai/api/v1"
NEXT_PUBLIC_API_URL="https://api.konnector.ai/api/v1"

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD PLATFORM INFRASTRUCTURE
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=konnector-ai-prod
GCP_REGION=us-central1
GCS_BUCKET_NAME=konnector-ai-prod-knowledge-assets

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL 16 CLOUD SQL WITH PGVECTOR)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://konnector_admin:your_database_password_here@localhost:5432/konnector_ai?schema=public"

# ------------------------------------------------------------------------------
# 4. CACHING & PUB/SUB (REDIS 7 MEMORYSTORE)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRATION=7d

# Firebase Auth Integration (Optional SSO)
FIREBASE_PROJECT_ID=konnector-ai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xyz@konnector-ai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your_firebase_private_key_pem_string"

# ------------------------------------------------------------------------------
# 6. GOOGLE VERTEX AI & GEMINI 2.5
# ------------------------------------------------------------------------------
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 7. META WHATSAPP CLOUD API (GRAPH API v21.0)
# ------------------------------------------------------------------------------
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL="https://graph.facebook.com"
WHATSAPP_PHONE_NUMBER_ID=108492039485721
WHATSAPP_BUSINESS_ACCOUNT_ID=WABA_EDU_9921
WHATSAPP_CLOUD_API_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=konnector_secure_verify_token_2026

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAYS (STRIPE & RAZORPAY)
# ------------------------------------------------------------------------------
# Stripe (Global USD/EUR Card Billing)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_STARTER=price_starter_monthly_id
STRIPE_PRICE_GROWTH=price_growth_monthly_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly_id

# Razorpay (India INR Billing with 18% GST Compliance)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 9. CALENDAR INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_REDIRECT_URI="https://api.konnector.ai/api/v1/appointments/oauth/callback"

# ==============================================================================
# KONNECTOR AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Multi-Tenant & Security
JWT_SECRET=your_konnector_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your_aes_256_hex_encryption_key_here

# Database (PostgreSQL Cloud SQL / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/konnector_ai?schema=public"

# Redis Cache & Queues (Cloud Memorystore / Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Cloud Platform & AI
GCP_PROJECT_ID=konnector-ai-prod
GCP_LOCATION=us-central1
GCP_STORAGE_BUCKET=konnector-ai-storage-documents
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Firebase Authentication (Admin SDK)
FIREBASE_PROJECT_ID=konnector-ai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@konnector-ai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your_firebase_private_key_pem_string"

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_WEBHOOK_VERIFY_TOKEN=konnector_secure_verify_token_2026
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=109283746529384

# Payment Gateways
# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Super Admin Initial Credentials
SUPER_ADMIN_EMAIL=admin@konnector.ai
SUPER_ADMIN_PASSWORD=your_initial_superadmin_password
